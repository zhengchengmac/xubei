			<key>Hour</key>
			<integer>15</integer>
			<key>Minute</key>
			<integer>1</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>20</integer>
			<key>Minute</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>StandardOutPath</key>
	<string>__PROJECT__/定时.log</string>
	<key>StandardErrorPath</key>
	<string>__PROJECT__/定时.log</string>
	<key>RunAtLoad</key>
	<false/>
